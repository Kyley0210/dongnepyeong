rules_version = '2';

// 동네평 Firestore 보안 규칙
// - 누구나 읽을 수 있고, 쓰기는 이메일 인증을 마친 로그인 사용자(익명 제외)만 자기 것만 할 수 있습니다.
// - 사장님은 손님 리뷰를 지울 수 없고 답글만 달 수 있습니다.
// - 같은 동네·같은 주소(주소가 없으면 같은 이름)의 가게는 addrKeys 잠금 문서로 한 번만 등록됩니다.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    // 이메일 인증까지 마친 사람만 새로 쓰거나 고칠 수 있습니다(구글 로그인은 이미 인증됨).
    // 지우기는 signedIn()만 확인 → 인증 전이라도 계정 삭제 때 자기 것을 지울 수 있습니다.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }
    // 마스터(관리자) 계정: 이 이메일로 인증된 계정은 모든 가게·리뷰·답글 등을 지울 수 있습니다.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'dongnaepyeong@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function me() { return request.auth.uid; }
    function optBool(d, k) { return !(k in d) || d[k] is bool; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }
    function optList(d, k, max) { return !(k in d) || (d[k] is list && d[k].size() <= max); }

    function validStore(d) {
      return str(d.name, 2, 30)
        && str(d.area, 1, 30)
        && str(d.cat, 1, 30)
        && optStr(d, 'address', 80)
        && optStr(d, 'hours', 60)
        && optStr(d, 'phone', 20)
        && optStr(d, 'menu', 80)
        && optStr(d, 'desc', 600)
        && optStr(d, 'photo', 40)
        && optList(d, 'photos', 10)
        && optStr(d, 'video', 40)
        && optStr(d, 'ownerName', 20)
        && optBool(d, 'chain')
        && optBool(d, 'reserve')
        && optList(d, 'closed', 11)
        && d.createdAt is number
        && str(d.addrKey, 10, 100);
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.ownerId == me()
        && validStore(request.resource.data)
        && (!('ownerName' in request.resource.data) || request.resource.data.ownerName == getAfter(/databases/$(database)/documents/bosses/$(me())).data.name)
        && getAfter(/databases/$(database)/documents/addrKeys/$(request.resource.data.addrKey)).data.storeId == storeId;
      allow update: if verified()
        && resource.data.ownerId == me()
        && request.resource.data.ownerId == me()
        && validStore(request.resource.data)
        && (!('ownerName' in request.resource.data) || request.resource.data.ownerName == getAfter(/databases/$(database)/documents/bosses/$(me())).data.name)
        && getAfter(/databases/$(database)/documents/addrKeys/$(request.resource.data.addrKey)).data.storeId == storeId;
      allow delete: if (signedIn() && resource.data.ownerId == me()) || isAdmin();
    }

    // 중복 등록 잠금: 한 주소 키는 한 가게만 가질 수 있고, 다른 사람이 가져갈 수 없습니다(update 없음).
    match /addrKeys/{key} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.ownerId == me()
        && getAfter(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == me()
        && getAfter(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.addrKey == key;
      allow delete: if (signedIn() && resource.data.ownerId == me()) || isAdmin();
    }

    // 리뷰 문서 ID = {가게ID}_{작성자uid} → 한 가게에 한 사람당 리뷰 1개
    match /reviews/{rid} {
      allow read: if true;
      allow create, update: if verified()
        && request.resource.data.authorId == me()
        && rid == request.resource.data.storeId + '_' + me()
        && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId))
        && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId != me()
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && str(request.resource.data.text, 5, 1000)
        && optStr(request.resource.data, 'nick', 12)
        && optList(request.resource.data, 'photos', 3)
        && optStr(request.resource.data, 'video', 40)
        && request.resource.data.createdAt is number;
      // 작성자, 그 가게 사장님, 관리자가 지울 수 있습니다.
      allow delete: if (signedIn() && resource.data.authorId == me())
        || (signedIn() && get(/databases/$(database)/documents/stores/$(resource.data.storeId)).data.ownerId == me())
        || isAdmin();
    }

    // 사장님 답글: 그 가게 주인만 쓰고 지울 수 있습니다.
    match /replies/{rid} {
      allow read: if true;
      allow create, update: if verified()
        && request.resource.data.ownerId == me()
        && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == me()
        && rid == request.resource.data.storeId + '_' + request.resource.data.authorId
        && str(request.resource.data.text, 1, 500);
      allow delete: if (signedIn() && resource.data.ownerId == me()) || isAdmin();
    }

    match /likes/{lid} {
      allow read: if true;
      allow create, update: if verified()
        && request.resource.data.uid == me()
        && lid == request.resource.data.key + '__' + me()
        && request.resource.data.at is number;
      allow delete: if (signedIn() && resource.data.uid == me()) || isAdmin();
    }

    match /favs/{fid} {
      allow read: if true;
      allow create, update: if verified()
        && request.resource.data.uid == me()
        && fid == request.resource.data.storeId + '_' + me()
        && request.resource.data.at is number;
      allow delete: if (signedIn() && resource.data.uid == me()) || isAdmin();
    }

    // 사진 (무료 요금제라 Storage 대신 Firestore에 압축 이미지로 저장). 한 장에 1MB 미만.
    match /photos/{pid} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.ownerId == me()
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000
        && request.resource.data.at is number;
      allow delete: if (signedIn() && resource.data.ownerId == me()) || isAdmin();
    }
    // 프로필: 닉네임#태그. 닉네임은 겹쳐도 되지만 조합(handles 잠금 문서)은 한 사람만.
    // 닉네임·태그는 마지막으로 바꾼 뒤 90일이 지나야 다시 바꿀 수 있고, 사진은 언제든 바꿀 수 있습니다.
    function hkey(d) { return d.name.lower() + '#' + d.tag.lower(); }
    function validProfile(d) {
      return d.keys().hasOnly(['name', 'tag', 'avatar', 'nameAt', 'createdAt'])
        && d.name is string && d.name.matches('^[0-9A-Za-z가-힣_]{2,12}$')
        && d.tag is string && d.tag.matches('^[0-9A-Za-z가-힣]{2,5}$')
        && optStr(d, 'avatar', 40)
        && d.nameAt is timestamp;
    }
    match /users/{uid} {
      allow read: if true;
      allow create: if verified() && uid == me()
        && validProfile(request.resource.data)
        && request.resource.data.nameAt == request.time
        && getAfter(/databases/$(database)/documents/handles/$(hkey(request.resource.data))).data.uid == me();
      allow update: if verified() && uid == me()
        && validProfile(request.resource.data)
        && (
          (request.resource.data.name == resource.data.name
            && request.resource.data.tag == resource.data.tag
            && request.resource.data.nameAt == resource.data.nameAt)
          || (request.time > resource.data.nameAt + duration.value(90, 'd')
            && request.resource.data.nameAt == request.time
            && getAfter(/databases/$(database)/documents/handles/$(hkey(request.resource.data))).data.uid == me())
        );
      allow delete: if (signedIn() && uid == me()) || isAdmin();
    }
    // 닉네임#태그 잠금: 이미 있으면 다른 사람이 만들 수 없음(update 없음).
    match /handles/{key} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.uid == me()
        && key == hkey(getAfter(/databases/$(database)/documents/users/$(me())).data);
      allow delete: if (signedIn() && resource.data.uid == me()) || isAdmin();
    }

    // 영상 (무료 요금제라 Storage 대신 0.9MB 조각으로 저장). 조각 최대 8개(약 7MB).
    match /videos/{vid} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.ownerId == me()
        && request.resource.data.n is int
        && request.resource.data.n >= 1 && request.resource.data.n <= 8
        && request.resource.data.at is number;
      allow delete: if (signedIn() && resource.data.ownerId == me()) || isAdmin();
      match /c/{ci} {
        allow read: if true;
        allow create: if verified()
          && request.resource.data.ownerId == me()
          && request.resource.data.data is bytes
          && request.resource.data.data.size() <= 900000
          && (!exists(/databases/$(database)/documents/videos/$(vid))
            || get(/databases/$(database)/documents/videos/$(vid)).data.ownerId == me());
        allow delete: if (signedIn() && resource.data.ownerId == me()) || isAdmin();
      }
    }
    // 사장님 이름: 한 사람당 하나, 다른 사람과 겹치면 안 됨(bossNames 잠금 문서).
    function bkey(n) { return n.lower().replace('\\s', ''); }
    match /bosses/{uid} {
      allow read: if true;
      allow create, update: if verified() && uid == me()
        && request.resource.data.keys().hasOnly(['name', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.matches('^[0-9A-Za-z가-힣][0-9A-Za-z가-힣 ._·&()\\-]{0,19}$')
        && getAfter(/databases/$(database)/documents/bossNames/$(bkey(request.resource.data.name))).data.uid == me();
      allow delete: if (signedIn() && uid == me()) || isAdmin();
    }
    match /bossNames/{key} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.uid == me()
        && key == bkey(getAfter(/databases/$(database)/documents/bosses/$(me())).data.name);
      allow delete: if (signedIn() && resource.data.uid == me()) || isAdmin();
    }

    // 예약: 신청한 손님, 그 가게 사장님, 관리자만 볼 수 있습니다.
    match /reservations/{rid} {
      allow read: if signedIn() && (resource.data.uid == me() || resource.data.ownerId == me() || isAdmin());
      allow create: if verified()
        && request.resource.data.uid == me()
        && request.resource.data.ownerId != me()
        && request.resource.data.ownerId == get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId
        && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.reserve == true
        && request.resource.data.status == 'pending'
        && str(request.resource.data.date, 10, 10)
        && str(request.resource.data.time, 5, 5)
        && request.resource.data.people is int
        && request.resource.data.people >= 1 && request.resource.data.people <= 50
        && optStr(request.resource.data, 'note', 200)
        && str(request.resource.data.storeName, 1, 30)
        && str(request.resource.data.who, 1, 20)
        && request.resource.data.at is number
        // 이미 확정된 시간(slots)은 신청할 수 없음
        && !(exists(/databases/$(database)/documents/slots/$(request.resource.data.storeId + '_' + request.resource.data.date))
          && request.resource.data.time in get(/databases/$(database)/documents/slots/$(request.resource.data.storeId + '_' + request.resource.data.date)).data.times);
      // 사장님: 수락/거절(+사유), 기록 숨기기(hideO). 손님: 취소, 기록 숨기기(hideU).
      allow update: if signedIn() && (
          (resource.data.ownerId == me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'statusAt'])
            && request.resource.data.status in ['accepted', 'declined']
            && optStr(request.resource.data, 'reason', 300))
          || (resource.data.ownerId == me()
            && resource.data.status in ['declined', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hideO']))
          // 확정 전·후 모두 양쪽이 취소 가능(사유 포함)
          || ((resource.data.uid == me() || resource.data.ownerId == me())
            && resource.data.status in ['pending', 'accepted']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt', 'cancelReason', 'cancelledBy'])
            && request.resource.data.status == 'cancelled'
            && optStr(request.resource.data, 'cancelReason', 300)
            && request.resource.data.cancelledBy == (resource.data.ownerId == me() ? 'owner' : 'user'))
          || (resource.data.uid == me()
            && resource.data.status in ['declined', 'cancelled']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hideU'])));
      allow delete: if signedIn() && (resource.data.uid == me() || resource.data.ownerId == me()) || isAdmin();
    }

    // 신고: 로그인한 사람이 보내고, 관리자만 읽고 지웁니다.
    match /reports/{id} {
      allow create: if verified()
        && request.resource.data.uid == me()
        && request.resource.data.type in ['bug', 'review']
        && optStr(request.resource.data, 'text', 1000)
        && optStr(request.resource.data, 'reason', 60)
        && request.resource.data.at is number;
      allow read, delete: if isAdmin();
    }
    // 예약 마감 시간표: 사장님 기기가 확정된 예약 시간을 적어 둠. 누구나 읽을 수 있음(시간만, 손님 정보 없음).
    match /slots/{sid} {
      allow read: if true;
      allow create, update: if verified()
        && request.resource.data.ownerId == me()
        && sid == request.resource.data.storeId + '_' + request.resource.data.date
        && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == me()
        && request.resource.data.times is list
        && request.resource.data.times.size() <= 48;
      allow delete: if (signedIn() && resource.data.ownerId == me()) || isAdmin();
    }

    // 삭제 안내 알림: 관리자는 누구에게나, 사장님은 자기 가게 리뷰를 지울 때 그 작성자에게만 보낼 수 있음.
    match /notices/{nid} {
      allow read: if signedIn() && resource.data.to == me();
      allow update: if signedIn() && resource.data.to == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if (signedIn() && resource.data.to == me()) || isAdmin();
      allow create: if verified()
        && request.resource.data.from == me()
        && request.resource.data.read == false
        && request.resource.data.at is number
        && str(request.resource.data.reason, 1, 300)
        && request.resource.data.type in ['review-deleted', 'store-deleted', 'reply-deleted']
        && (isAdmin()
          || (request.resource.data.type == 'review-deleted'
            && request.resource.data.by == 'owner'
            && get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.ownerId == me()
            && exists(/databases/$(database)/documents/reviews/$(request.resource.data.storeId + '_' + request.resource.data.to))));
    }
    // 팔로우: 문서 ID = 나_상대. 내 팔로우만 만들고 지움(상대도 나를 팔로워에서 지울 수 있음).
    match /follows/{fid} {
      allow read: if true;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['from', 'to', 'at'])
        && request.resource.data.from == me()
        && request.resource.data.to is string
        && request.resource.data.to != me()
        && fid == me() + '_' + request.resource.data.to
        && request.resource.data.at is number;
      allow delete: if (signedIn() && (resource.data.from == me() || resource.data.to == me())) || isAdmin();
    }
  }
}
